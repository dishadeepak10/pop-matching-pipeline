            "payment_status",
            "current_status",
            "receipt_status"
        ),

        "transaction_number": get_value(
            data,
            "transaction_number",
            "transaction_id",
            "transaction_reference",
            "transfer_details.reference_number"
        ),

        "tracking_number": get_value(
